# ── agent-gen.ca backend environment ──────────────────────────────────────
# Copy to .env and fill in production values.
# See docs/configuration.md for the full contract.

# Environment: "development" | "production"
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver).
# Production MUST use a non-loopback host.
DATABASE_URL=postgresql+asyncpg://agentgen:agentgen123@localhost:5432/agentgen

# ── Redis ─────────────────────────────────────────────────────────────────
# Used for rate limiting, session management, and job queues.
# Production MUST use a non-loopback host.
REDIS_URL=redis://localhost:6379

# ── Security ──────────────────────────────────────────────────────────────
# JWT signing key. Production MUST set a real secret (min 32 bytes recommended).
SECRET_KEY=change-in-production

# JWT algorithm (HS256 default)
ALGORITHM=HS256

# Access token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# Max concurrent sessions per user (default: 3)
MAX_ACTIVE_SESSIONS_PER_USER=3

# Nonce TTL for sign-in challenges in minutes (default: 5)
NONCE_EXPIRE_MINUTES=5

# ── Cookies ───────────────────────────────────────────────────────────────
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict
# REFRESH_COOKIE_DOMAIN=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limits ───────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_CHALLENGE=20/minute
AUTH_RATE_LIMIT_VERIFY=10/minute
AUTH_RATE_LIMIT_REFRESH=30/minute

# ── JWT claims ────────────────────────────────────────────────────────────
JWT_ISSUER=agent-gen.ca
JWT_AUDIENCE=agent-gen.ca-web
JWT_LEEWAY_SECONDS=30

# ── SIWS auth ─────────────────────────────────────────────────────────────
# These MUST match the production domain exactly.
AUTH_DOMAIN=agent-gen.ca
AUTH_URI=https://agent-gen.ca
AUTH_CHAIN_ID=solana:mainnet
AUTH_STATEMENT=Sign in to agent-gen.ca

# ── Solana ────────────────────────────────────────────────────────────────
# Cluster: "localnet" | "devnet" | "mainnet-beta"
# Production MUST NOT use "localnet".
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com
# SOLANA_RPC_FALLBACK=https://fallback-rpc.example.com

# ── Payments (Release B) ─────────────────────────────────────────────────
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PLATFORM_FEE_BPS=250

# ── Migrations ────────────────────────────────────────────────────────────
ENFORCE_ALEMBIC_VERSION=false
# ALEMBIC_EXPECTED_REVISION=

# ── Project ───────────────────────────────────────────────────────────────
PROJECT_NAME=agent-gen.ca
