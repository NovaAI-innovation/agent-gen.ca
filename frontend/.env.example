# ── agent-gen.ca frontend environment ─────────────────────────────────────
# Copy to .env.local for local development.
# All NEXT_PUBLIC_* variables are exposed to the browser.
# See docs/configuration.md for the full contract.

# ── Environment ───────────────────────────────────────────────────────────
# "development" | "production"
ENVIRONMENT=development

# ── API ───────────────────────────────────────────────────────────────────
# Backend API base URL. In production behind nginx, use "/api".
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Solana ────────────────────────────────────────────────────────────────
# Cluster: "localnet" | "devnet" | "mainnet-beta"
# Production MUST NOT use "localnet".
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# Primary RPC endpoints
NEXT_PUBLIC_SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com

# Comma-separated fallback RPC endpoints (optional)
# NEXT_PUBLIC_SOLANA_RPC_FALLBACK=https://fallback-rpc.example.com

# ── Payments (Release B) ─────────────────────────────────────────────────
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_PLATFORM_FEE_BPS=250
