# Production Environment Variables

# Railway Backend + Database
RAILWAY_PROJECT_ID=your-railway-project-id
RAILWAY_SERVICE_ID_BACKEND=your-backend-service-id
RAILWAY_SERVICE_ID_DB=your-db-service-id
DATABASE_URL=postgresql://agentgen:${POSTGRES_PASSWORD}@containers-us-west-123.railway.app:5432/railway
POSTGRES_PASSWORD=your-prod-postgres-password

# Backend Secrets
SECRET_KEY=your-production-secret-key-64-chars-long
JWT_SECRET=your-jwt-secret-key
REDIS_URL=redis://redis.railway.internal:6379

# Frontend Vercel
VERCEL_PROJECT_ID=your-vercel-project-id
NEXT_PUBLIC_API_URL=https://api.agent-gen.ca
NEXT_PUBLIC_SITE_URL=https://agent-gen.ca

# CORS
ALLOWED_ORIGINS=https://agent-gen.ca,https://www.agent-gen.ca

# Sentry (optional)
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/

# Railway Environment
RAILWAY_ENVIRONMENT=production
RAILWAY_STATIC_URL=https://agent-gen.ca

# Vercel Environment
VERCEL_ENV=production
VERCEL_URL=https://agent-gen.ca

# Health Check
HEALTH_CHECK_PATH=/health
