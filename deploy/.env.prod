# Production-like local container environment
# Safe defaults so `docker compose -f docker-compose.prod.yml up` works out of the box.
# Replace secrets before any internet-exposed deployment.

# Database (compose postgres service)
POSTGRES_DB=agentgen
POSTGRES_USER=agentgen
POSTGRES_PASSWORD=agentgen-prod-local
DATABASE_URL=postgresql+asyncpg://agentgen:agentgen-prod-local@db:5432/agentgen

# Backend
SECRET_KEY=agentgen-prod-local-secret-change-me
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict
JWT_ISSUER=agent-gen.ca
JWT_AUDIENCE=agent-gen.ca-web
ENFORCE_ALEMBIC_VERSION=true

# Solana (production-like defaults)
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK=
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PLATFORM_FEE_BPS=250
AUTH_DOMAIN=agent-gen.ca
AUTH_URI=https://agent-gen.ca
AUTH_CHAIN_ID=solana:mainnet

# Frontend (behind nginx in compose)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_FALLBACK=
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_PLATFORM_FEE_BPS=250
